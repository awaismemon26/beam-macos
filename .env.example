# Copy to .env (git-ignored) and fill in. Read by Tools/generate.sh and Tools/install.sh.

# Your Apple Development team ID (Xcode ▸ Settings ▸ Accounts, or the OU field of your
# "Apple Development" certificate). With a team, macOS keeps Beam's Accessibility permission
# across rebuilds. Leave empty for an unsigned (ad-hoc) build.
BEAM_TEAM_ID=
